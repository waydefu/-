{
  "name": "fantasy-lore-guardian",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:functions",
    "build:functions": "npm --prefix functions run build",
    "check": "npm run check:frontend && npm run check:functions",
    "check:frontend": "npm --prefix functions exec tsc -- --project jsconfig.json --noEmit",
    "check:functions": "npm --prefix functions run build -- --noEmit",
    "test": "npm run build:functions && node --test tests/*.test.mjs",
    "test:rules": "firebase emulators:exec --only firestore \"node --test tests/firestore-emulator.emu.mjs\"",
    "smoke:hosting": "node scripts/smoke-hosting.mjs",
    "audit:functions": "npm --prefix functions audit"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "firebase": "^12.13.0"
  }
}
